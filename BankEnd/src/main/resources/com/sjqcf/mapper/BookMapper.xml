<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sjqcf.mapper.BookMapper">
    <insert id="starBook">
        insert into user_book_favorites(book_id,user_id) values(#{bookId},#{userId})
    </insert>

    <delete id="cancelStarBook">
        delete from user_book_favorites where book_id = #{bookId} and user_id = #{userId}
    </delete>

    <select id="getBooks" resultType="com.sjqcf.pojo.Book">
        select * from books
    </select>

    <select id="findById" resultType="com.sjqcf.pojo.Book">
        select * from books where id = #{id}
    </select>

    <select id="findByCategory" resultType="com.sjqcf.pojo.Book">
        select * from books where category = #{category}
    </select>

    <select id="findByName" resultType="com.sjqcf.pojo.Book">
        select * from books where name like concat('%',#{name},'%')
    </select>

    <select id="findUserStarBooks" resultType="com.sjqcf.pojo.Book">
        select * from books where id in (select book_id from user_book_favorites where user_id = #{userId})
    </select>

    <select id="checkStarBook" resultType="java.lang.Integer">
        select exists(select * from user_book_favorites where book_id = #{bookId} and user_id = #{userId})
    </select>
</mapper>